# Domain và URL frontend
SITE_ADDRESS=checkin.example.com
APP_ORIGIN=https://checkin.example.com
COOKIE_SECURE=true

# Cổng map ra máy chủ VPS (mặc định 127.0.0.1:3006:3000 cho Nginx host proxy)
APP_PORT=127.0.0.1:3006:3000

# Docker image đã được GitHub Actions build sẵn
IMAGE_NAME=ghcr.io/linhlgdev1124007/checkin:latest

# Sinh bằng: openssl rand -base64 36
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Tạo bot qua @BotFather, thêm bot vào nhóm rồi điền hai giá trị này.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

TZ=Asia/Ho_Chi_Minh

